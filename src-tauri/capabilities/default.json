{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to every Orbit window. Orbit deliberately does NOT enable the shell, fs or http plugins on the frontend: anything that touches the filesystem, spawns a process or talks to a network endpoint is implemented in Rust and exposed as an explicit #[tauri::command], so the webview can never be tricked into arbitrary execution.",
  "windows": ["orb", "command-center", "settings"],
  "permissions": [
    "core:default",
    "core:app:allow-app-hide",
    "core:app:allow-app-show",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-cursor-position",
    "core:webview:allow-internal-toggle-devtools",
    "store:default",
    "global-shortcut:default",
    "opener:default",
    "dialog:default"
  ]
}
