<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Caduceus is a menu-bar utility: no Dock icon, no app-switcher entry.
	     Everything is reachable from the tray icon, the staff and the hotkey. -->
	<key>LSUIElement</key>
	<true/>

	<key>CFBundleDisplayName</key>
	<string>Caduceus</string>
	<key>CFBundleName</key>
	<string>Caduceus</string>

	<!-- Shown by macOS the first time push-to-talk records audio. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Caduceus records audio only while you hold the push-to-talk key, so it can transcribe what you said into the Command Center.</string>

	<!-- Shown when the on-device speech recogniser is used as the STT backend. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Caduceus uses speech recognition to turn your push-to-talk recording into text.</string>

	<key>NSScreenCaptureUsageDescription</key>
	<string>Caduceus captures the screen when you take a screenshot or start a screen recording.</string>

	<!-- The `caduceus://` scheme, used only by one-click workflow links.
	     Registering a scheme means any web page can hand this app a URL, so
	     nothing about opening one executes: `workflows::handle_deep_link`
	     parses and stages it, and the import is not written until the user has
	     seen exactly what it would add and pressed a button. See the threat
	     model at the top of `src-tauri/src/workflows.rs`. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.caduceus.desktop.workflow</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>caduceus</string>
			</array>
		</dict>
	</array>

	<!-- Shown when a shortcut of kind `run_applescript` is executed. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Caduceus runs the AppleScript shortcuts you have configured yourself.</string>

	<!-- Shown the first time a computer-use agent step captures the screen.
	     Caduceus never captures the screen until you approve an agent session. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Caduceus only reads files you explicitly reference in a shortcut.</string>
</dict>
</plist>
