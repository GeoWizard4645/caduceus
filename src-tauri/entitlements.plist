<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push-to-talk needs the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Talking to AI providers / local model servers. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Computer use drives other applications via Accessibility + Apple Events.
	     macOS still requires the user to grant these in System Settings the first
	     time an agent step runs; these entitlements only make that grant possible. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- Required for the JIT-less WKWebView Tauri embeds when hardened runtime
	     is enabled during notarisation. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
